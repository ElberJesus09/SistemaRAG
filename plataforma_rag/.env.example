# Copia este archivo a .env y completa las credenciales.
# La clave service_role y la de Gemini NUNCA deben salir del servidor.

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

APP_ENV=development
# En produccion deja solo el dominio real de la app web.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# Modelos
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Recuperacion
RETRIEVAL_MATCH_COUNT=6
RETRIEVAL_THRESHOLD=0.55
SLOW_REQUEST_MS=5000

# Conversaciones
CONVERSATION_MAX_MESSAGES=20
CONVERSATION_MEMORY_MESSAGES=6

# Rendimiento y limites
# Segundos que se reutiliza un perfil ya validado antes de volver a preguntarle
# a Supabase. 0 lo desactiva (dos viajes de red por peticion).
AUTH_CACHE_SECONDS=300
AUTH_CACHE_MAX_ENTRIES=2048
# Preguntas por usuario y hora. 0 lo desactiva.
ASK_RATE_LIMIT_PER_HOUR=60
# Cada cuantos chunks se guarda el progreso de una carga.
INGESTION_PROGRESS_EVERY=5
MAX_UPLOAD_MB=20

# Registro
LOG_LEVEL=INFO
# true = una linea JSON por evento, recomendable en produccion.
LOG_JSON=false
